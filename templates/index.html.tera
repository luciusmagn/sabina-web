<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ content.meta.title }}</title>
  <meta name="description" content="{{ content.meta.description }}">
  <meta property="og:title" content="{{ content.meta.title }}">
  <meta property="og:description" content="{{ content.meta.description }}">
  <meta property="og:type" content="website">
  <script>
    // Set the theme before first paint to avoid a flash of the wrong mode.
    (function () {
      var theme = null;
      try { theme = localStorage.getItem("theme"); } catch (e) {}
      if (theme !== "light" && theme !== "dark") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  {# ---- Fixed chrome: language + theme, travelling contact chip ---- #}
  <div class="top-controls">
    <button class="lang-toggle" type="button"
            data-cs="{{ content.ui.languageButton.cs }}" data-en="{{ content.ui.languageButton.en }}"
            data-aria-cs="{{ content.ui.languageToggle.cs }}" data-aria-en="{{ content.ui.languageToggle.en }}"
            aria-label="{{ content.ui.languageToggle.cs }}">{{ content.ui.languageButton.cs }}</button>
    <button class="theme-toggle" type="button" aria-pressed="false"
            data-aria-cs="{{ content.ui.themeToggle.cs }}" data-aria-en="{{ content.ui.themeToggle.en }}"
            aria-label="{{ content.ui.themeToggle.cs }}">
      <svg class="icon-sun" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="16" cy="16" r="7" fill="currentColor"/>
        <path d="M16 2v5M16 25v5M2 16h5M25 16h5M6 6l3.5 3.5M22.5 22.5L26 26M26 6l-3.5 3.5M9.5 22.5L6 26" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9.5 2.4A11.9 11.9 0 0 0 21.1 20.6 11 11 0 0 1 13.1 24C7 23.8 2.2 19 2.1 12.9 2 8 5 4 9.5 2.4Z" fill="currentColor"/>
      </svg>
    </button>
  </div>

  <a class="chip" href="#kontakt"
     data-aria-cs="{{ content.tiles.kontakt.cs }}" data-aria-en="{{ content.tiles.kontakt.en }}"
     aria-label="{{ content.tiles.kontakt.cs }}" hidden>
    <span aria-hidden="true">@</span>
  </a>

  <main>

    {# ================= HERO — one big flat field ================= #}
    <section class="hero" id="domu">
      <div class="hero-inner">
        <h1 class="hero-name">{{ content.hero | safe }}</h1>
        <p class="hero-tagline" data-cs="{{ content.tagline.cs }}" data-en="{{ content.tagline.en }}">{{ content.tagline.cs }}</p>

        <a class="hero-contact" href="#kontakt">
        <span class="hero-contact-label" data-cs="{{ content.tiles.kontakt.cs }}" data-en="{{ content.tiles.kontakt.en }}">{{ content.tiles.kontakt.cs }}</span>
        <span class="hero-contact-reveal">
          <span>{{ content.contact.email }}</span>
          <span class="hero-contact-sep" aria-hidden="true">/</span>
          <span>{{ content.contact.linkedinLabel }}</span>
          </span>
        </a>
      </div>

      <a class="scroll-cue" href="#prace"
         data-aria-cs="{{ content.ui.scrollDown.cs }}" data-aria-en="{{ content.ui.scrollDown.en }}"
         aria-label="{{ content.ui.scrollDown.cs }}">
        <span class="scroll-cue-label" data-cs="{{ content.ui.scrollDown.cs }}" data-en="{{ content.ui.scrollDown.en }}">{{ content.ui.scrollDown.cs }}</span>
        <svg class="trace trace--arrow" viewBox="0 0 34 52" fill="none" aria-hidden="true">
          <path d="M16.2 4C17.4 15 17.8 26 16.9 44.5M16.9 44.5C13.4 40.8 11.2 38.9 6 36.2M16.9 44.5C20.8 41.4 23.6 39 28.4 37" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
      </a>
    </section>

    {# ================= WORK — ring of category cards =================
       A circular 3D carousel (one card per category). The centre card shows
       the category name + an open pill that "land" on arrival; clicking it
       flips the card over to a vertical scroll of that category's projects. #}
    <section class="ring" id="prace">
      <h2 class="sr-only" data-cs="Práce" data-en="Work">Práce</h2>

      <div class="ring-stage">

        {# ---- 1 · visual identity ---- #}
        <div class="rcard">
          <div class="rcard-inner">
            <button class="rcard-front" type="button">
              <span class="rcard-title" data-cs="{{ content.tiles.viz.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.viz.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.viz.cs | replace(from="<br>", to=" ") | striptags }}</span>
              <span class="rcard-open" data-cs="Otevřít" data-en="Open">Otevřít</span>
            </button>
            <div class="rcard-back">
              <div class="rback-head">
                <h3 class="rback-title" data-cs="{{ content.tiles.viz.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.viz.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.viz.cs | replace(from="<br>", to=" ") | striptags }}</h3>
                <button class="rback-close" type="button"
                        data-aria-cs="{{ content.ui.close.cs }}" data-aria-en="{{ content.ui.close.en }}"
                        aria-label="{{ content.ui.close.cs }}">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.2 2.8C8 8.4 13 13.6 21.2 21M21 3.4C14 9.8 8.6 15.4 3 21.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </button>
              </div>
              <div class="rback-scroll">
                <article class="proj">
                  <button class="proj-zoom" type="button" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                    <img src="{{ content.visualIdentity.detail.wideImage }}" alt="" loading="lazy">
                  </button>
                  <p class="proj-cap">
                    <strong data-cs="{{ content.visualIdentity.detail.label.cs }}" data-en="{{ content.visualIdentity.detail.label.en }}">{{ content.visualIdentity.detail.label.cs }}</strong>
                    <span data-cs="{{ content.visualIdentity.detail.caption.cs }}" data-en="{{ content.visualIdentity.detail.caption.en }}">{{ content.visualIdentity.detail.caption.cs }}</span>
                  </p>
                </article>
                <article class="proj">
                  <button class="proj-zoom" type="button" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                    <img src="{{ content.visualIdentity.detail.sideImage }}" alt="" loading="lazy">
                  </button>
                </article>
                {% for d in content.visualIdentity.devices %}
                <article class="proj">
                  <button class="proj-zoom" type="button" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                    <img src="{{ d }}" alt="" loading="lazy">
                  </button>
                </article>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        {# ---- 2 · product photo ---- #}
        <div class="rcard">
          <div class="rcard-inner">
            <button class="rcard-front" type="button">
              <span class="rcard-title" data-cs="{{ content.tiles.produkt.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.produkt.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.produkt.cs | replace(from="<br>", to=" ") | striptags }}</span>
              <span class="rcard-open" data-cs="Otevřít" data-en="Open">Otevřít</span>
            </button>
            <div class="rcard-back">
              <div class="rback-head">
                <h3 class="rback-title" data-cs="{{ content.tiles.produkt.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.produkt.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.produkt.cs | replace(from="<br>", to=" ") | striptags }}</h3>
                <button class="rback-close" type="button"
                        data-aria-cs="{{ content.ui.close.cs }}" data-aria-en="{{ content.ui.close.en }}"
                        aria-label="{{ content.ui.close.cs }}">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.2 2.8C8 8.4 13 13.6 21.2 21M21 3.4C14 9.8 8.6 15.4 3 21.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </button>
              </div>
              <div class="rback-scroll">
                {% for set in content.productSets %}
                  {% if set.layout == "rows" %}
                    {% for row in set.rows %}{% for img in row %}
                    <article class="proj">
                      <button class="proj-zoom" type="button" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                        <img src="{{ img.0 }}" alt="" loading="lazy">
                      </button>
                      <p class="proj-cap">
                        <strong data-cs="{{ set.label.cs }}" data-en="{{ set.label.en }}">{{ set.label.cs }}</strong>
                        <span data-cs="{{ set.caption.cs }}" data-en="{{ set.caption.en }}">{{ set.caption.cs }}</span>
                      </p>
                    </article>
                    {% endfor %}{% endfor %}
                  {% else %}
                    {% for img in set.images %}
                    <article class="proj">
                      <button class="proj-zoom" type="button" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                        <img src="{{ img.0 }}" alt="" loading="lazy">
                      </button>
                      <p class="proj-cap">
                        <strong data-cs="{{ set.label.cs }}" data-en="{{ set.label.en }}">{{ set.label.cs }}</strong>
                        <span data-cs="{{ set.caption.cs }}" data-en="{{ set.caption.en }}">{{ set.caption.cs }}</span>
                      </p>
                    </article>
                    {% endfor %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        {# ---- 3 · portraits ---- #}
        <div class="rcard">
          <div class="rcard-inner">
            <button class="rcard-front" type="button">
              <span class="rcard-title" data-cs="{{ content.tiles.profilovky.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.profilovky.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.profilovky.cs | replace(from="<br>", to=" ") | striptags }}</span>
              <span class="rcard-open" data-cs="Otevřít" data-en="Open">Otevřít</span>
            </button>
            <div class="rcard-back">
              <div class="rback-head">
                <h3 class="rback-title" data-cs="{{ content.tiles.profilovky.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.profilovky.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.profilovky.cs | replace(from="<br>", to=" ") | striptags }}</h3>
                <button class="rback-close" type="button"
                        data-aria-cs="{{ content.ui.close.cs }}" data-aria-en="{{ content.ui.close.en }}"
                        aria-label="{{ content.ui.close.cs }}">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.2 2.8C8 8.4 13 13.6 21.2 21M21 3.4C14 9.8 8.6 15.4 3 21.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </button>
              </div>
              <div class="rback-scroll">
                {% for p in content.profilePhotos.photos %}
                <article class="proj">
                  <button class="proj-zoom" type="button" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                    <img src="{{ p.src }}" alt="{{ p.title.cs }}" loading="lazy">
                  </button>
                  <p class="proj-cap">
                    <strong data-cs="{{ p.title.cs }}" data-en="{{ p.title.en }}">{{ p.title.cs }}</strong>
                    <span data-cs="{{ p.text.cs }}" data-en="{{ p.text.en }}">{{ p.text.cs }}</span>
                  </p>
                </article>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        {# ---- 4 · videos ---- #}
        <div class="rcard">
          <div class="rcard-inner">
            <button class="rcard-front" type="button">
              <span class="rcard-title" data-cs="{{ content.tiles.videa.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.videa.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.videa.cs | replace(from="<br>", to=" ") | striptags }}</span>
              <span class="rcard-open" data-cs="Otevřít" data-en="Open">Otevřít</span>
            </button>
            <div class="rcard-back">
              <div class="rback-head">
                <h3 class="rback-title" data-cs="{{ content.tiles.videa.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.videa.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.videa.cs | replace(from="<br>", to=" ") | striptags }}</h3>
                <button class="rback-close" type="button"
                        data-aria-cs="{{ content.ui.close.cs }}" data-aria-en="{{ content.ui.close.en }}"
                        aria-label="{{ content.ui.close.cs }}">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.2 2.8C8 8.4 13 13.6 21.2 21M21 3.4C14 9.8 8.6 15.4 3 21.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </button>
              </div>
              <div class="rback-scroll">
                {% for v in content.videos %}
                <article class="proj proj--video">
                  <button class="proj-play" type="button" data-video-src="{{ v.src }}"
                          data-aria-cs="{{ v.name.cs }}" data-aria-en="{{ v.name.en }}" aria-label="{{ v.name.cs }}">
                    <img src="{{ v.poster }}" alt="" loading="lazy">
                    <svg class="proj-play-mark" viewBox="0 0 60 60" fill="none" aria-hidden="true">
                      <path d="M30 4.5C13 6 4.8 14.6 5.6 30.8 6.4 46 15 55.4 30.6 55.5 46 55.6 55 45.8 55.4 30 55.8 13.8 46.6 5.4 30 4.5Z" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/>
                      <path d="M24.5 20.5C24.2 27.4 24.3 32.9 24.8 40.2 30.6 36.6 34.9 33.7 40.6 29.6 34.5 25.9 30.5 23.6 24.5 20.5Z" fill="currentColor"/>
                    </svg>
                  </button>
                  <p class="proj-cap">
                    {% if v.link %}<a href="{{ v.link }}" target="_blank" rel="noopener"><strong data-cs="{{ v.name.cs }}" data-en="{{ v.name.en }}">{{ v.name.cs }}</strong></a>{% else %}<strong data-cs="{{ v.name.cs }}" data-en="{{ v.name.en }}">{{ v.name.cs }}</strong>{% endif %}
                    <span data-cs="/{{ v.work.cs }}/" data-en="/{{ v.work.en }}/">/{{ v.work.cs }}/</span>
                  </p>
                </article>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        {# ---- 5 · typography ---- #}
        <div class="rcard">
          <div class="rcard-inner">
            <button class="rcard-front" type="button">
              <span class="rcard-title" data-cs="{{ content.tiles.typografie.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.typografie.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.typografie.cs | replace(from="<br>", to=" ") | striptags }}</span>
              <span class="rcard-open" data-cs="Otevřít" data-en="Open">Otevřít</span>
            </button>
            <div class="rcard-back">
              <div class="rback-head">
                <h3 class="rback-title" data-cs="{{ content.tiles.typografie.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.typografie.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.typografie.cs | replace(from="<br>", to=" ") | striptags }}</h3>
                <button class="rback-close" type="button"
                        data-aria-cs="{{ content.ui.close.cs }}" data-aria-en="{{ content.ui.close.en }}"
                        aria-label="{{ content.ui.close.cs }}">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.2 2.8C8 8.4 13 13.6 21.2 21M21 3.4C14 9.8 8.6 15.4 3 21.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </button>
              </div>
              <div class="rback-scroll">
                {% for b in content.books %}
                <article class="proj proj--kniha">
                  <button class="proj-zoom" type="button" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                    <img src="{{ b.image }}" alt="{{ b.title }} — {{ b.author }}" loading="lazy">
                  </button>
                  <p class="proj-cap">
                    <strong>{{ b.title }}</strong>
                    <span data-cs="{{ b.author }} · /{{ b.activity.cs }}/" data-en="{{ b.author }} · /{{ b.activity.en }}/">{{ b.author }} · /{{ b.activity.cs }}/</span>
                  </p>
                </article>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

      </div>

      <div class="ring-nav">
        <button class="ring-btn ring-prev" type="button"
                data-aria-cs="{{ content.ui.previous.cs }}" data-aria-en="{{ content.ui.previous.en }}"
                aria-label="{{ content.ui.previous.cs }}">
          <svg viewBox="0 0 44 24" fill="none" aria-hidden="true"><path d="M40 12.5C27 11.6 17 11.8 5.5 12.4M5.5 12.4C9.8 9.2 12 7.4 15 4M5.5 12.4C9.4 15.6 11.8 17.6 15.4 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
        </button>
        <button class="ring-btn ring-next" type="button"
                data-aria-cs="{{ content.ui.next.cs }}" data-aria-en="{{ content.ui.next.en }}"
                aria-label="{{ content.ui.next.cs }}">
          <svg viewBox="0 0 44 24" fill="none" aria-hidden="true"><path d="M4 12.5C17 11.6 27 11.8 38.5 12.4M38.5 12.4C34.2 9.2 32 7.4 29 4M38.5 12.4C34.6 15.6 32.2 17.6 28.6 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
        </button>
      </div>
    </section>

    {# ================= CONTACT — the second flat field ================= #}
    <section class="kontakt" id="kontakt">
      <p class="kontakt-bio" data-cs="{{ content.contact.bio.cs }}" data-en="{{ content.contact.bio.en }}">{{ content.contact.bio.cs }}</p>

      <a class="kontakt-mail" href="mailto:{{ content.contact.email }}">
        <span class="kontakt-mail-text">{{ content.contact.email }}</span>
        <svg class="trace trace--ring" viewBox="0 0 520 110" fill="none" preserveAspectRatio="none" aria-hidden="true">
          <path d="M262 14C150 10 28 22 20 54c-8 34 96 46 240 44 146-2 246-16 240-46-5-27-104-40-198-38" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
        </svg>
      </a>

      <div class="kontakt-row">
        <a class="kontakt-li" href="{{ content.contact.linkedinUrl }}" target="_blank" rel="noopener">LinkedIn — {{ content.contact.linkedinLabel }}</a>
        <span class="chip-slot" aria-hidden="true"></span>
      </div>

      <div class="walker-track" aria-hidden="true">
        <svg class="walker" viewBox="0 0 120 164" fill="none">
          <circle cx="62" cy="26" r="13.5" stroke="currentColor" stroke-width="3.6"/>
          <path d="M61 41C60 55 60.8 68 61.5 88" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
          <path class="w-limb w-arm-a" d="M61 52C54 61 48 69 41.5 78" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
          <path class="w-limb w-arm-b" d="M61 52C68.5 61.5 74 69 80.5 77" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
          <path class="w-limb w-leg-a" d="M61.5 88C55 105 49 119 42.5 135" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
          <path class="w-limb w-leg-b" d="M61.5 88C67.5 105 73 119 79 134" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
        </svg>
      </div>

      <p class="kontakt-foot">© <span class="kontakt-year">2026</span> Sabina Mácha</p>
    </section>

  </main>

  <dialog class="lightbox" aria-label="Náhled">
    <button class="lightbox-close" type="button"
            data-aria-cs="{{ content.ui.close.cs }}" data-aria-en="{{ content.ui.close.en }}"
            aria-label="{{ content.ui.close.cs }}">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M3.2 2.8C8 8.4 13 13.6 21.2 21M21 3.4C14 9.8 8.6 15.4 3 21.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="lightbox-media"></div>
  </dialog>

  <script src="/js/main.js" defer></script>
</body>
</html>

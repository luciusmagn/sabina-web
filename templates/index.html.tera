<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ content.meta.title }}</title>
  <meta name="description" content="{{ content.meta.description }}">
  <meta property="og:title" content="{{ content.meta.title }}">
  <meta property="og:description" content="{{ content.meta.description }}">
  <meta property="og:type" content="website">
  <script>
    // Set the theme before first paint to avoid a flash of the wrong mode.
    (function () {
      var theme = null;
      try { theme = localStorage.getItem("theme"); } catch (e) {}
      if (theme !== "light" && theme !== "dark") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap">
  <link rel="stylesheet" href="/css/style.css?v=26">
</head>
<body>

  {# ---- Fixed chrome: language + theme, travelling contact chip ---- #}
  <div class="top-controls">
    <button class="lang-toggle" type="button"
            data-cs="{{ content.ui.languageButton.cs }}" data-en="{{ content.ui.languageButton.en }}"
            data-aria-cs="{{ content.ui.languageToggle.cs }}" data-aria-en="{{ content.ui.languageToggle.en }}"
            aria-label="{{ content.ui.languageToggle.cs }}">{{ content.ui.languageButton.cs }}</button>
    <button class="theme-toggle" type="button" aria-pressed="false"
            data-aria-cs="{{ content.ui.themeToggle.cs }}" data-aria-en="{{ content.ui.themeToggle.en }}"
            aria-label="{{ content.ui.themeToggle.cs }}">
      <svg class="icon-sun" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="16" cy="16" r="7" fill="currentColor"/>
        <path d="M16 2v5M16 25v5M2 16h5M25 16h5M6 6l3.5 3.5M22.5 22.5L26 26M26 6l-3.5 3.5M9.5 22.5L6 26" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9.5 2.4A11.9 11.9 0 0 0 21.1 20.6 11 11 0 0 1 13.1 24C7 23.8 2.2 19 2.1 12.9 2 8 5 4 9.5 2.4Z" fill="currentColor"/>
      </svg>
    </button>
  </div>

  <main>

    {# ================= HERO — one big flat field ================= #}
    <section class="hero" id="domu">
      <div class="hero-inner">
        <h1 class="hero-name">{{ content.hero | safe }}</h1>
        <p class="hero-tagline" data-cs="{{ content.tagline.cs }}" data-en="{{ content.tagline.en }}">{{ content.tagline.cs }}</p>

        <div class="hero-contact">
        <a class="hero-contact-label" href="#kontakt" data-cs="{{ content.tiles.kontakt.cs }}" data-en="{{ content.tiles.kontakt.en }}">{{ content.tiles.kontakt.cs }}</a>
        <span class="hero-contact-reveal">
          <span class="hero-contact-email">{{ content.contact.email }}</span>
          </span>
        </div>
      </div>

      <a class="scroll-cue" href="#prace"
         data-aria-cs="{{ content.ui.scrollDown.cs }}" data-aria-en="{{ content.ui.scrollDown.en }}"
         aria-label="{{ content.ui.scrollDown.cs }}">
        <span class="scroll-cue-label" data-cs="{{ content.ui.scrollDown.cs }}" data-en="{{ content.ui.scrollDown.en }}">{{ content.ui.scrollDown.cs }}</span>
        <svg class="trace trace--arrow" viewBox="0 0 34 52" fill="none" aria-hidden="true">
          <path d="M17 5V44M6.5 33.5L17 44L27.5 33.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </section>

    {# ================= WORK — ring of category cards =================
       A circular 3D carousel (one card per category). The centre card shows
       the category name + an open pill that "land" on arrival; clicking it
       flips the card over to a vertical scroll of that category's projects. #}
    <section class="ring" id="prace">
      <h2 class="sr-only" data-cs="Práce" data-en="Work">Práce</h2>

      <div class="ring-stage">

        {# ---- 1 · visual identity ---- #}
        <div class="rcard">
          <div class="rcard-inner">
            <button class="rcard-front" type="button">
              <span class="rcard-cover" aria-hidden="true"><img src="/covers/viz.jpg" alt=""></span>
              <span class="rcard-label">
                <span class="rcard-title" data-cs="{{ content.tiles.viz.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.viz.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.viz.cs | replace(from="<br>", to=" ") | striptags }}</span>
                <span class="rcard-open" data-cs="Otevřít" data-en="Open">Otevřít</span>
              </span>
            </button>
            <div class="rcard-back">
              <div class="rback-scroll" tabindex="0">
                {# page 1 — the Krulichovi brand set: logos + printed mockups #}
                <article class="proj proj--set">
                  <header class="proj-set-head">
                    <h3 class="proj-set-title" data-cs="{{ content.visualIdentity.detail.label.cs }}" data-en="{{ content.visualIdentity.detail.label.en }}">{{ content.visualIdentity.detail.label.cs }}</h3>
                    <p class="proj-set-cap" data-cs="{{ content.visualIdentity.detail.caption.cs }}" data-en="{{ content.visualIdentity.detail.caption.en }}">{{ content.visualIdentity.detail.caption.cs }}</p>
                  </header>
                  <div class="proj-set-media">
                    <div class="proj-set-row proj-set-row--contain">
                      <button class="proj-zoom" type="button" style="--ar: 1.85" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                        <img src="{{ content.visualIdentity.detail.wideImage }}" alt="" loading="lazy">
                      </button>
                      <button class="proj-zoom" type="button" style="--ar: 1.28" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                        <img src="{{ content.visualIdentity.detail.sideImage }}" alt="" loading="lazy">
                      </button>
                    </div>
                  </div>
                </article>
                {# page 2 — the web design on devices #}
                <article class="proj proj--set">
                  <div class="proj-set-media">
                    <div class="proj-set-row proj-set-row--contain">
                      {% for d in content.visualIdentity.devices %}
                      <button class="proj-zoom" type="button" style="--ar: 0.72" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                        <img src="{{ d }}" alt="" loading="lazy">
                      </button>
                      {% endfor %}
                    </div>
                  </div>
                </article>
              </div>
            </div>
          </div>
        </div>

        {# ---- 2 · product photo ---- #}
        <div class="rcard">
          <div class="rcard-inner">
            <button class="rcard-front" type="button">
              <span class="rcard-cover" aria-hidden="true"><img src="/covers/produkt.jpg" alt=""></span>
              <span class="rcard-label">
                <span class="rcard-title" data-cs="{{ content.tiles.produkt.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.produkt.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.produkt.cs | replace(from="<br>", to=" ") | striptags }}</span>
                <span class="rcard-open" data-cs="Otevřít" data-en="Open">Otevřít</span>
              </span>
            </button>
            <div class="rcard-back">
              <div class="rback-scroll" tabindex="0">
                {# one page per product set: its name + caption, photos grouped #}
                {% for set in content.productSets %}
                <article class="proj proj--set">
                  <header class="proj-set-head">
                    <h3 class="proj-set-title" data-cs="{{ set.label.cs }}" data-en="{{ set.label.en }}">{{ set.label.cs }}</h3>
                    <p class="proj-set-cap" data-cs="{{ set.caption.cs }}" data-en="{{ set.caption.en }}">{{ set.caption.cs }}</p>
                  </header>
                  {% if set.layout == "rows" %}
                  <div class="proj-set-media">
                    {% for row in set.rows %}
                    <div class="proj-set-row">
                      {% for img in row %}
                      <button class="proj-zoom" type="button" style="--ar: {{ img.1 }}" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                        <img src="{{ img.0 }}" alt="" loading="lazy">
                      </button>
                      {% endfor %}
                    </div>
                    {% endfor %}
                  </div>
                  {% else %}
                  <div class="proj-set-media proj-set-media--grid">
                    {% for img in set.images %}
                    <button class="proj-zoom" type="button" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                      <img src="{{ img.0 }}" alt="" loading="lazy">
                    </button>
                    {% endfor %}
                  </div>
                  {% endif %}
                </article>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        {# ---- 3 · portraits — the albums card: opens off-centre, one person
                per page (full-bleed photo + name + open-album pill) ---- #}
        <div class="rcard rcard--albums">
          <div class="rcard-inner">
            <button class="rcard-front" type="button">
              <span class="rcard-cover" aria-hidden="true"><img src="/covers/portrety.jpg" alt=""></span>
              <span class="rcard-label">
                <span class="rcard-title" data-cs="{{ content.tiles.profilovky.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.profilovky.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.profilovky.cs | replace(from="<br>", to=" ") | striptags }}</span>
                <span class="rcard-open" data-cs="Otevřít" data-en="Open">Otevřít</span>
              </span>
            </button>
            <div class="rcard-back">
              <div class="rback-scroll" tabindex="0">
                {% for p in content.profilePhotos.photos %}
                <article class="proj proj--person">
                  <img class="person-photo" src="{{ p.src }}" alt="{{ p.title.cs }}" loading="lazy">
                  <div class="person-id">
                    <h3 class="person-name" data-cs="{{ p.title.cs }}" data-en="{{ p.title.en }}">{{ p.title.cs }}</h3>
                    <p class="person-role" data-cs="{{ p.text.cs }}" data-en="{{ p.text.en }}">{{ p.text.cs }}</p>
                  </div>
                  {% if p.album is defined %}
                  <button class="person-album-btn" type="button"
                          data-person="{{ p.title.cs }}"
                          data-album="{% for a in p.album %}{{ a }}{% if not loop.last %}|{% endif %}{% endfor %}"
                          data-cs="Otevřít album" data-en="Open album">Otevřít album</button>
                  {% endif %}
                </article>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        {# ---- 4 · videos ---- #}
        <div class="rcard">
          <div class="rcard-inner">
            <button class="rcard-front" type="button">
              <span class="rcard-cover" aria-hidden="true"><img src="/covers/videa.jpg" alt="" data-exposure="0.6" data-contrast="1.08"></span>
              <span class="rcard-label">
                <span class="rcard-title" data-cs="{{ content.tiles.videa.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.videa.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.videa.cs | replace(from="<br>", to=" ") | striptags }}</span>
                <span class="rcard-open" data-cs="Otevřít" data-en="Open">Otevřít</span>
              </span>
            </button>
            <div class="rcard-back">
              <div class="rback-scroll" tabindex="0">
                {% for v in content.videos %}
                <article class="proj proj--video">
                  <button class="proj-play" type="button" data-video-src="{{ v.src }}"
                          data-aria-cs="{{ v.name.cs }}" data-aria-en="{{ v.name.en }}" aria-label="{{ v.name.cs }}">
                    <img src="{{ v.poster }}" alt="" loading="lazy">
                    <svg class="proj-play-mark" viewBox="0 0 60 60" fill="none" aria-hidden="true">
                      <path d="M30 4.5C13 6 4.8 14.6 5.6 30.8 6.4 46 15 55.4 30.6 55.5 46 55.6 55 45.8 55.4 30 55.8 13.8 46.6 5.4 30 4.5Z" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/>
                      <path d="M24.5 20.5C24.2 27.4 24.3 32.9 24.8 40.2 30.6 36.6 34.9 33.7 40.6 29.6 34.5 25.9 30.5 23.6 24.5 20.5Z" fill="currentColor"/>
                    </svg>
                  </button>
                  <p class="proj-cap">
                    <span data-cs="/{{ v.work.cs }}/" data-en="/{{ v.work.en }}/">/{{ v.work.cs }}/</span>
                  </p>
                </article>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        {# ---- 5 · typography ---- #}
        <div class="rcard">
          <div class="rcard-inner">
            <button class="rcard-front" type="button">
              <span class="rcard-cover" aria-hidden="true"><img src="/covers/typografie.jpg" alt="" data-exposure="1.32" data-contrast="1.32"></span>
              <span class="rcard-label">
                <span class="rcard-title" data-cs="{{ content.tiles.typografie.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.typografie.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.typografie.cs | replace(from="<br>", to=" ") | striptags }}</span>
                <span class="rcard-open" data-cs="Otevřít" data-en="Open">Otevřít</span>
              </span>
            </button>
            <div class="rcard-back">
              <div class="rback-scroll" tabindex="0">
                {% for b in content.books %}
                <article class="proj proj--kniha">
                  <button class="proj-zoom" type="button" data-aria-cs="{{ content.ui.enlarge.cs }}" data-aria-en="{{ content.ui.enlarge.en }}" aria-label="{{ content.ui.enlarge.cs }}">
                    <img src="{{ b.image }}" alt="{{ b.title }} — {{ b.author }}" loading="lazy">
                  </button>
                  <p class="proj-cap">
                    <span data-cs="{{ b.title }}, {{ b.author }} · /{{ b.activity.cs }}/" data-en="{{ b.title }}, {{ b.author }} · /{{ b.activity.en }}/">{{ b.title }}, {{ b.author }} · /{{ b.activity.cs }}/</span>
                  </p>
                </article>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

      </div>

      {# floating intro beside the open albums card — over the veil, the
         other cards stay visible behind (desktop only) #}
      {% if content.profilePhotos.intro is defined %}
        {% set albums_intro_cs = content.profilePhotos.intro.cs %}
        {% set albums_intro_en = content.profilePhotos.intro.en %}
      {% else %}
        {% set albums_intro_cs = "Portréty focené v ateliéru i venku. Každý člověk má vlastní album — otevřete ho tlačítkem na kartě." %}
        {% set albums_intro_en = "Portraits shot in the studio and outdoors. Each person has an album of their own — open it with the button on the card." %}
      {% endif %}
      <aside class="ring-albums-intro" aria-hidden="true">
        <h3 class="albums-intro-title" data-cs="{{ content.tiles.profilovky.cs | replace(from="<br>", to=" ") | striptags }}" data-en="{{ content.tiles.profilovky.en | replace(from="<br>", to=" ") | striptags }}">{{ content.tiles.profilovky.cs | replace(from="<br>", to=" ") | striptags }}</h3>
        <p class="albums-intro-text" data-cs="{{ albums_intro_cs }}" data-en="{{ albums_intro_en }}">{{ albums_intro_cs }}</p>
      </aside>

      <div class="ring-nav">
        <button class="ring-btn ring-prev" type="button"
                data-aria-cs="{{ content.ui.previous.cs }}" data-aria-en="{{ content.ui.previous.en }}"
                aria-label="{{ content.ui.previous.cs }}">
          <svg viewBox="0 0 44 24" fill="none" aria-hidden="true"><path d="M39 12H7M16.5 4.5L7 12L16.5 19.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="ring-btn ring-next" type="button"
                data-aria-cs="{{ content.ui.next.cs }}" data-aria-en="{{ content.ui.next.en }}"
                aria-label="{{ content.ui.next.cs }}">
          <svg viewBox="0 0 44 24" fill="none" aria-hidden="true"><path d="M5 12H37M27.5 4.5L37 12L27.5 19.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      {# one-click exits: up to the hero, down to the footer #}
      <div class="ring-jump">
        <a class="ring-jump-btn ring-jump-btn--up" href="#domu"
           data-aria-cs="Nahoru" data-aria-en="To the top" aria-label="Nahoru">
          <svg viewBox="0 0 34 52" fill="none" aria-hidden="true">
            <path d="M17 5V44M6.5 33.5L17 44L27.5 33.5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a class="ring-jump-btn" href="#kontakt"
           data-aria-cs="{{ content.tiles.kontakt.cs }}" data-aria-en="{{ content.tiles.kontakt.en }}"
           aria-label="{{ content.tiles.kontakt.cs }}">
          <svg viewBox="0 0 34 52" fill="none" aria-hidden="true">
            <path d="M17 5V44M6.5 33.5L17 44L27.5 33.5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>

    {# ================= CONTACT — the second flat field ================= #}
    <section class="kontakt" id="kontakt">
      <p class="kontakt-bio" data-cs="{{ content.contact.bio.cs }}" data-en="{{ content.contact.bio.en }}">{{ content.contact.bio.cs }}</p>

      <div class="kontakt-lines">
        <a class="kontakt-line" href="mailto:{{ content.contact.email }}">
          <svg viewBox="0 0 28 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M26 0H2C1.46957 0 0.960859 0.210714 0.585786 0.585786C0.210714 0.960859 0 1.46957 0 2V18C0 18.5304 0.210714 19.0391 0.585786 19.4142C0.960859 19.7893 1.46957 20 2 20H26C26.5304 20 27.0391 19.7893 27.4142 19.4142C27.7893 19.0391 28 18.5304 28 18V2C28 1.46957 27.7893 0.960859 27.4142 0.585786C27.0391 0.210714 26.5304 0 26 0ZM23.8 2L14 8.78L4.2 2H23.8ZM2 18V2.91L13.43 10.82C13.5974 10.9361 13.7963 10.9984 14 10.9984C14.2037 10.9984 14.4026 10.9361 14.57 10.82L26 2.91V18H2Z" fill="currentColor"/>
          </svg>
          <span>{{ content.contact.email }}</span>
        </a>
        <a class="kontakt-line" href="{{ content.contact.linkedinUrl }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M22.2 0H1.8C0.8 0 0 0.8 0 1.7V22.2C0 23.1 0.8 23.9 1.8 23.9H22.2C23.2 23.9 24 23.1 24 22.2V1.7C24 0.8 23.2 0 22.2 0ZM7.1 20.4H3.6V9H7.1V20.4ZM5.4 7.4C4.3 7.4 3.3 6.5 3.3 5.3C3.3 4.1 4.2 3.2 5.4 3.2C6.5 3.2 7.5 4.1 7.5 5.3C7.5 6.5 6.5 7.4 5.4 7.4ZM20.5 20.3H17V14.7C17 13.4 17 11.6 15.1 11.6C13.2 11.6 13 13.1 13 14.5V20.2H9.5V9H12.8V10.5H12.9C13.4 9.6 14.6 8.6 16.3 8.6C19.9 8.6 20.6 11 20.6 14.1V20.3H20.5Z" fill="currentColor"/>
          </svg>
          <span>{{ content.contact.linkedinLabel }}</span>
        </a>
      </div>

      <div class="walker-track" aria-hidden="true">
        <svg class="walker" viewBox="0 0 120 164" fill="none">
          <circle cx="62" cy="26" r="13.5" stroke="currentColor" stroke-width="3.6"/>
          <path d="M61 41C60 55 60.8 68 61.5 88" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
          <path class="w-limb w-arm-a" d="M61 52C54 61 48 69 41.5 78" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
          <path class="w-limb w-arm-b" d="M61 52C68.5 61.5 74 69 80.5 77" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
          <path class="w-limb w-leg-a" d="M61.5 88C55 105 49 119 42.5 135" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
          <path class="w-limb w-leg-b" d="M61.5 88C67.5 105 73 119 79 134" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
        </svg>
      </div>

      <p class="kontakt-foot">© <span class="kontakt-year">2026</span> Sabina Mácha</p>
    </section>

  </main>

  {# ---- album overlay: one person's photo collection over a pink veil.
        A <dialog>, so Esc + top-layer stacking (lightbox above it) come free. #}
  <dialog class="album-overlay" aria-label="Album">
    <button class="album-close" type="button"
            data-aria-cs="{{ content.ui.close.cs }}" data-aria-en="{{ content.ui.close.en }}"
            aria-label="{{ content.ui.close.cs }}">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M4 4L20 20M20 4L4 20" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
    </button>
    <h3 class="album-title"></h3>
    <div class="album-grid"></div>
  </dialog>

  <dialog class="lightbox" aria-label="Náhled">
    <button class="lightbox-close" type="button"
            data-aria-cs="{{ content.ui.close.cs }}" data-aria-en="{{ content.ui.close.en }}"
            aria-label="{{ content.ui.close.cs }}">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M3.2 2.8C8 8.4 13 13.6 21.2 21M21 3.4C14 9.8 8.6 15.4 3 21.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="lightbox-media"></div>
  </dialog>

  <script src="/js/main.js?v=26" defer></script>
</body>
</html>
